# VividCoder Local FastAPI Configuration (macOS 127.0.0.1 only)
# Precedence: OS environment variables > backend/.env > built-in defaults
# Never commit actual .env files or credentials to version control.
VIVIDCODER_HOST=127.0.0.1
VIVIDCODER_PORT=8000
VIVIDCODER_OLLAMA_URL=http://127.0.0.1:11434
VIVIDCODER_DEFAULT_MODEL=qwen3.5:4b
VIVIDCODER_EVALUATION_MODEL=qwen3.5:9b
VIVIDCODER_DEFAULT_NUM_CTX=8192
VIVIDCODER_MAX_NUM_CTX=16384
VIVIDCODER_KEEP_ALIVE=5m
VIVIDCODER_DB_PATH=vividcoder.db
VIVIDCODER_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
VIVIDCODER_WS_MAX_FRAME_BYTES=262144
VIVIDCODER_WS_MAX_HISTORY_MESSAGES=100
